# Frontend environment example — copy to `.env` (do not commit real secrets).

# When VITE_MOCK_MODE=false, the frontend will hit the FastAPI backend at
# VITE_API_BASE_URL. Start the backend with `docker compose up` from ./backend
# and the default below matches the local dev configuration.

VITE_ENVIRONMENT=development
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_VERSION=v1
VITE_MOCK_MODE=true
VITE_DEBUG=false
VITE_LOG_LEVEL=warn

# AI mocks are OFF by default so failed real requests never silently return
# fixture content. Set to `true` for offline demos.
VITE_ENABLE_AI_MOCKS=false
