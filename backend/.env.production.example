# Backend production environment template. Copy to `.env.production` and
# fill in real values. Never commit the populated file.

APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=CHANGE_ME_TO_A_64_CHAR_RANDOM_STRING
APP_ACCESS_TOKEN_MINUTES=15
APP_REFRESH_TOKEN_DAYS=14

# Database — point at managed PostgreSQL 16+.
DATABASE_URL=postgresql+psycopg2://platform:CHANGE_ME@postgres:5432/platform
DATABASE_URL_ASYNC=postgresql+asyncpg://platform:CHANGE_ME@postgres:5432/platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=platform

# Cache & queue
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://platform:CHANGE_ME@rabbitmq:5672//
RABBITMQ_USER=platform
RABBITMQ_PASSWORD=CHANGE_ME

# CORS — comma-separated list of allowed frontend origins.
CORS_ORIGINS=https://app.example.com

# AI providers
AI_PROVIDER=lovable
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LOVABLE_API_KEY=
LOVABLE_AI_MODEL=google/gemini-3-flash-preview
AI_RATE_LIMIT_PER_MINUTE=60

# Translation
TRANSLATION_BACKEND=ai
INDICTRANS2_MODEL=ai4bharat/indictrans2-en-indic-1B

# Communication
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FCM_SERVER_KEY=

# Storage
STORAGE_BACKEND=s3
STORAGE_LOCAL_ROOT=/var/lib/platform/uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Runtime tuning
RATE_LIMIT_PER_MINUTE=240
API_REPLICAS=2
WORKER_REPLICAS=2
WORKER_CONCURRENCY=4

# Feature flags
FEATURE_ANALYTICS=true
FEATURE_SEARCH=true
FEATURE_UPLOADS=true
FEATURE_AI=true
MAINTENANCE_MODE=false
