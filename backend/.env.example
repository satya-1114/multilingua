APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-64-char-random-string
APP_ACCESS_TOKEN_MINUTES=30
APP_REFRESH_TOKEN_DAYS=14

DATABASE_URL=postgresql+psycopg2://platform:platform@postgres:5432/platform
DATABASE_URL_ASYNC=postgresql+asyncpg://platform:platform@postgres:5432/platform

REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- AI Intelligence Platform (Milestone 10) --------------------------------
# Free-first providers. Leave any block blank to skip; the platform
# auto-selects the first configured one in this order:
#   Gemini > Ollama > Hugging Face > watsonx > OpenAI

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_ENABLED=true

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-13b-chat-v2

# Fernet key (URL-safe base64, 32 bytes) for workspace-level AI secrets.
# Leave blank in dev — derived from APP_SECRET_KEY. Set in production so
# rotating APP_SECRET_KEY does not invalidate stored provider keys.
AI_SECRET_ENCRYPTION_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/var/lib/platform/uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
